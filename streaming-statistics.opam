opam-version: "2.0"
synopsis: "Streaming statistics with explicit accuracy and merge contracts"
description: """
A compact OCaml library for exact and approximate one-pass statistics.
It separates mergeable moment accumulators, exact order statistics, and
capacity-controlled randomized summaries instead of giving them a false common
interface.
"""
maintainer: "Riad Darwish"
authors: ["Riad Darwish"]
license: "MIT"
homepage: "https://github.com/fus3r/streaming-statistics"
bug-reports: "https://github.com/fus3r/streaming-statistics/issues"
dev-repo: "git+https://github.com/fus3r/streaming-statistics.git"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.12"}
  "ocamlfind" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
